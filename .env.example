# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser.
# Set these as Wrangler secrets in production (`wrangler secret put NAME`),
# not in this file or in wrangler.jsonc.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
IMPERSONATION_JWT_SECRET=generate-a-long-random-string
